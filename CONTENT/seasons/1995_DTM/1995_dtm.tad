// TAD (teams and drivers) format
// UNDER DEVELOPMENT! MORE OPTIONS TO COME!
//
// pit crew colour definitons:
// BLACK, DARK_GREY, GREY, DARK_RED, FADED_RED, YELLOW, DARK_BEIGE, LIGHT_BLUE, MID_BLUE, DARK_BLUE, LIGHT_GREEN, MID_GREEN, DARK_GREEN
//
// not listed commands: 
//		- team_weight_lbs (or _kg): used inside a TEAM tag { } (for further info, read the changelog)
//		- baseline_weight_lbs (or _kg): used in the header (for further info, read the changelog)
//		- DISABLE_DRIVER: place it as the final command in a driver tag { }

name "1995 Deutsche Tourenwagen Meisterschaft (DTM)"
author "Berthier"
description "Relive the legendary 1995 DTM Championship with authentic cars, teams, liveries, and immersive racing action from the golden era of touring car racing."
year 1995

car_weight_lbs 1313   // or kg, GP2's native format is lbs, lbs is used here to keep the exact vanilla value, you can use kg but that will go through a conversion first
pit_speed_limit_mph 50   // or kmh, GP2's native format is mph, mph is used here to keep the exact vanilla value, you can use kmh but that will go through a conversion first

refuelling 0		// 0 = off (no refuelling is allowed during races in DTM, at least in 1995)

carshape "1995_dtm.dat"   // if not default then a filename from the mod's carshapes folder
engine_sound "1995_DTM" // a directory name from the enginesounds directory

tyre_dry_type "slick"  // or grooved
tyre_brand#0 "nobranding"   // "default" (yellow Goodyear), "nobranding" or a filename from content/tyrebrands/ without the extension, the extension and the format is assumed to be .png
tyre_brand#1 "notused"   // "notused" or a filename for those pesky tyre war years
tyre_jams "no_wheel.jam" "no_wheel.jam" "no_wheel.jam" "no_wheel.jam" // the external tyre sprites, if not default then filenames from the tyres folder, the order in this list is B1FTR.JAM B2FTR.JAM B1RTR.JAM B2RTR.JAM

helmets "default"   // if not default (the original) then it's looking for it in the mod's helmets folder

TEAM #1
{
	team_name "Rosberg"
	engine_name "Opel Calibra"

	carshape_var 0			// 0 = low nose, 1 = high nose with the original carshape
	livery "rosberg.jam"   // if not from the default JAMs then a filename from your_mod/liveries/, IMPORTANT: NO custom livery can have the original filenames!
	tyre_brand 0

	team_color 15 19 83   // the colour that appears on the track overlay, colours that take 3 values are RGB colours

	cockpit_color 187 179 7
	mirror_color 187 179 7
	frontwing_color 231 231 231

	power_race 760
	power_quali 760
	fail_prob 6700

	CREW
	{
		feet					BLACK
		legs_pit_monitor		DARK_BLUE
		waist					DARK_BLUE
		thin_strip				YELLOW
		left_chest_sign			YELLOW
		right_chest				YELLOW
		epaulettes_jack			YELLOW
		right_upper_arm			GREY
		right_forearm			GREY
		left_upper_arm			GREY
		left_forearm			GREY
		hands					BLACK
		head					BLACK
		team_logo				DARK_RED
	}

	DRIVER #1
	{
		driver_number 1
		driver_name "Klaus Ludwig"
		driver_nationality "DEU"

		driver_grip_race 15888
		driver_grip_quali 15888
		driver_random_grip_range 1434
	}

	DRIVER #2
	{
		driver_number 2
		driver_name "Keke Rosberg"
		driver_nationality "FIN"

		driver_grip_race 15263
		driver_grip_quali 15263
		driver_random_grip_range 2059
	}
}

